{
  "id": "root",
  "type": "column",
  "theme": "my-dracula",
  "preview": "layouts/my-dracula.svg",
  "font": "UDEV Gothic 35JPDOC",
  "ui_font": "UDEV Gothic 35JPDOC",
  "titlebar": "none",
  "traffic_lights": [14, 12],
  "background": "canvas",
  "terminal_padding": [12, 10],
  "children": [
    {
      "id": "hud",
      "type": "block",
      "content": { "mod": "my-dracula", "props": { "role": "hud" } },
      "size": { "px": 36 },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "divider": { "width": 2, "color": "#44475a" },
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": { "px": 270 },
          "min": 44,
          "max": 480,
          "divider": { "width": 2, "color": "#44475a" },
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": { "mod": "my-dracula", "props": { "role": "spaces" } },
              "size": { "weight": 1 },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": { "mod": "my-dracula", "props": { "role": "agents" } },
              "size": { "weight": 1 },
              "min": 90
            }
          ]
        },
        {
          "id": "work",
          "type": "column",
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": { "mod": "my-dracula", "props": { "role": "tabs" } },
              "size": { "px": 34 }
            },
            {
              "id": "work-body",
              "type": "row",
              "padding": 6,
              "gap": 6,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": { "mod": "my-dracula", "props": { "role": "pane" } },
                        "reveal": "always",
                        "height": 28,
                        "position": "top"
                      },
                      "background": "background",
                      "border": { "width": 2, "color": "#44475a" },
                      "focus": { "width": 2, "color": "#bd93f9" },
                      "radius": 0,
                      "gap": 6,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "size": { "px": 380 },
                  "min": 280,
                  "max": 900,
                  "hidden": true,
                  "border": { "width": 2, "color": "#44475a" },
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        { "id": "files", "type": "block", "content": { "mod": "files" } },
                        { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "content": { "mod": "my-dracula", "props": { "role": "status" } },
      "size": { "px": 26 }
    }
  ]
}
